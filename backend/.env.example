DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Driver note: the installed driver is psycopg2-binary. URLs carrying a
# +psycopg qualifier are normalized to +psycopg2 at startup (see sanitize).
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
CLERK_JWKS_URL=https://REPLACE_WITH_CLERK_DOMAIN/.well-known/jwks.json
# Enforced when set; configure from the Clerk dashboard in production.
CLERK_ISSUER=https://REPLACE_WITH_CLERK_DOMAIN
CLERK_AUDIENCE=
# In-process JWKS cache TTL (seconds). Test-token bypass works ONLY when
# CLERK_JWKS_URL is empty AND ENVIRONMENT is not production.
JWKS_CACHE_TTL_SECONDS=600
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET
FRONTEND_ORIGIN=http://localhost:5173
VISION_API_URL=http://localhost:8000

# ── Reminders & Notifications ──
# Optional: If omitted, the backend will log "failed_missing_config" safely.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM=onboarding@resend.dev
# Delivery provider selection: auto|smtp|resend|disabled (default auto)
DELIVERY_PROVIDER=auto
# SMTP delivery (used when DELIVERY_PROVIDER=auto|smtp and RESEND_API_KEY absent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PAWPHILE <no-reply@pawphile.com>
# ── PAW AI provider ──
# PAW_AI_PROVIDER=auto selects Muse Glimmer 30 when MUSE_GLIMMER_API_KEY is
# set, otherwise the legacy Groq path. Values: auto|glimmer|groq.
# The Glimmer secret belongs in Render Environment Variables ONLY — never in
# git, source, tests, logs, or frontend bundles.
PAW_AI_PROVIDER=auto
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
MUSE_GLIMMER_API_KEY=
MUSE_GLIMMER_BASE_URL=
MUSE_GLIMMER_MODEL=
# ── Firebase Cloud Messaging (for edge functions) ──
# Used by Supabase edge functions to send push notifications

# Firebase service account configuration (placeholder)
# Populate with JSON content for edge functions as needed.
# Example fields: type, project_id, private_key_id, private_key, client_email, client_id, auth_uri, token_uri, auth_provider_x509_cert_url, client_x509_cert_url, universe_domain


# ── Vet Locator (Optional) ──
# Google Places Nearby Search (type=veterinary_care) is the preferred
# veterinary place-discovery layer. Server-side key ONLY — never expose in
# VITE_* frontend variables. When absent, the endpoint falls back to
# OpenStreetMap Nominatim open data (no key required).
GOOGLE_PLACES_API_KEY=

# ── PAWNEWS External Feeds (Optional) ──
# If omitted, PAWNEWS will fallback to internal verified 'local' and 'guide' seeds.
GUARDIAN_API_KEY=REPLACE_WITH_GUARDIAN_API_KEY
GNEWS_API_KEY=REPLACE_WITH_GNEWS_API_KEY
NEWSDATA_API_KEY=REPLACE_WITH_NEWSDATA_API_KEY

# ── Supabase (Database & Storage) ──
SUPABASE_URL=REPLACE_WITH_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# https://pawphile-empowering-smarter-dog-parenting.onrender.com

# ── BIN1 production: rate limiting / worker / retention ──
# In-memory sliding windows; no external service required.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SYNC_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60
# Shared secret for scheduler/cron callers of /api/v1/worker/* (empty = user-auth only).
WORKER_CRON_TOKEN=
WORKER_BATCH_LIMIT=50
WORKER_STALE_MINUTES=10
WORKER_MAX_ATTEMPTS=5
# Retention is operational hygiene only; health records are never auto-deleted.
# Days to keep terminal notifications / acked sync ops / revoked-expired shares.
# RETENTION_AUDIT_DAYS=0 means audit logs are retained forever (default).
RETENTION_NOTIFICATION_DAYS=90
RETENTION_SYNCOP_DAYS=30
RETENTION_SHARE_DAYS=180
RETENTION_AUDIT_DAYS=0
# ── BIN4 ecosystem retention (delivery log + failed/stale import attempts only) ──
# Connections, relationships, credentials, IMPORTED events are never auto-purged.
RETENTION_WEBHOOK_DAYS=90
RETENTION_IMPORT_DAYS=30
# ── BIN4 webhooks (outbound signed event delivery) ──
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_S=10.0
# ── BIN2 intelligence thresholds (descriptive, not clinical) ──
INTEL_STABLE_PCT_THRESHOLD=5.0
INTEL_VARIABLE_R2=0.35
INTEL_CHANGE_MAD_Z=3.0
INTEL_CHANGE_MIN_PCT=10.0
INTEL_WEIGHT_CHANGE_MIN_PCT=5.0
INTEL_OUTLIER_MAD_Z=5.0
LOG_LEVEL=INFO
ENVIRONMENT=development